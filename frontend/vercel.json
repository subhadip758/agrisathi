{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "build",
  "rewrites": [
    {
      "source": "/api/v1/:path*",
      "destination": "https://fruity-towns-sink.loca.lt/api/v1/:path*"
    },
    {
      "source": "/health",
      "destination": "https://fruity-towns-sink.loca.lt/health"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
