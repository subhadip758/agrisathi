# AGriSathi V3 Environment Configuration Example

# Server Configuration
PORT=5180
NODE_ENV=development
API_VERSION=v1
CORS_ORIGIN=http://localhost:3000

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/agrisathi_v3

# Authentication & Security
JWT_SECRET=your_super_secret_jwt_key_here_agrisathi_v3
JWT_EXPIRE=30d

# AI Models (Google Gemini API Keys)
# GEMINI_API_KEY_3 / DISEASE_API_KEY / GEMINI_API_KEY
GEMINI_API_KEY_3=your_gemini_api_key_here
GEMINI_API_KEY_2=your_secondary_gemini_api_key_here_optional
DISEASE_API_KEY=your_gemini_api_key_for_disease_detection

# Weather Data Provider API
WEATHER_API_KEY=your_openweather_api_key_here_optional
WEATHER_API_URL=https://api.openweathermap.org/data/2.5

# Machine Learning Service URL
ML_SERVICE_URL=http://localhost:8000
